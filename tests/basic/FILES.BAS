' File handling statements
OPEN "TEST.DAT" FOR OUTPUT AS #1
PRINT #1, "line"
CLOSE #1
OPEN "TEST.DAT" FOR APPEND AS #1
CLOSE 1
OPEN "TEST.DAT" FOR INPUT AS #2
DO WHILE NOT EOF(2)
    LINE INPUT #2, l$
LOOP
CLOSE #2
OPEN "R", #3, "REC.DAT", 32
FIELD #3, 10 AS n$, 22 AS m$
LSET n$ = "name"
RSET m$ = "value"
PUT #3, 1
PUT #3
GET #3, 1
GET #3
p = LOC(3)
q = LOF(3)
CLOSE #3
OPEN "REC.DAT" FOR RANDOM ACCESS READ WRITE SHARED AS #4 LEN = 16
LOCK #4, 1 TO 5
UNLOCK #4, 1 TO 5
LOCK #4
UNLOCK #4
CLOSE
OPEN "REC.DAT" FOR INPUT ACCESS READ LOCK WRITE AS #5
WIDTH #5, 40
CLOSE #5
NAME "TEST.DAT" AS "TEST2.DAT"
KILL "TEST2.DAT"
FILES "*.DAT"
FILES
MKDIR "SUBDIR"
CHDIR "SUBDIR"
CHDIR ".."
RMDIR "SUBDIR"
RESET
PRINT p; q
END
